# Copy to .env at the REPOSITORY ROOT. The copied .env is ignored by Git.
# Do not commit passwords or use VITE_ prefixes for database values.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ledgerline_migrator
MYSQL_PASSWORD=replace_locally
MYSQL_DATABASE=banking_payroll_db
# Development only: permits the explicitly invoked fictional seed script.
ALLOW_DEMO_SEED=false
# Remote MySQL requires verified TLS. Path to CA PEM file, if required:
MYSQL_SSL_CA=
MYSQL_SSL=false
# Phase 4 runtime: separate restricted login; never put these in VITE_* values.
# npm run app:setup creates local values and .env.admin.json (all ignored).
MYSQL_RUNTIME_USER=
MYSQL_RUNTIME_PASSWORD=
AUTH_SECRET=
APP_ORIGIN=http://127.0.0.1:5173
API_PORT=3001
# Used only by the administrative first-user setup script:
BOOTSTRAP_EMAIL=
BOOTSTRAP_NAME=
